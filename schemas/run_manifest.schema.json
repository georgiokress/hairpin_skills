{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterarbeit.local/schemas/phase_b_spi_run_manifest_v1.json",
  "title": "Phase B SPI run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "architecture",
    "process",
    "frames",
    "acquisition",
    "software",
    "doe",
    "ground_truth",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "phase_b_spi_run_manifest_v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "run_id",
        "purpose",
        "repetition_index",
        "created_at_utc"
      ],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "run_id": {
          "type": "string",
          "pattern": "^pb_spi_s4_setznest2_intctrl_atipass_d015_(?:v[0-9]{4}_fn[0-9]{3}_[a-z0-9_]+|endval4arm10v3_[a-z0-9_]+)_r[0-9]{3}$"
        },
        "purpose": {
          "enum": [
            "qualification",
            "reference_training",
            "doe_training",
            "validation",
            "validation_manual",
            "validation_x0",
            "validation_best_doe",
            "validation_spi"
          ]
        },
        "repetition_index": {"type": "integer", "minimum": 1},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "operator": {"type": "string"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_force_source",
        "ati_role",
        "ati_control_influence",
        "ati_rtde_bridge_used"
      ],
      "properties": {
        "control_force_source": {"const": "internal_UR_FT"},
        "ati_role": {"const": "passive_reference"},
        "ati_control_influence": {"const": false},
        "ati_rtde_bridge_used": {"const": false}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_direction",
        "slide_distance_m",
        "slide_speed_mps",
        "normal_force_magnitude_n",
        "normal_force_command_n",
        "manual_reference_frozen"
      ],
      "properties": {
        "slide_direction": {"const": "+x_R"},
        "slide_distance_m": {"const": 0.015},
        "slide_speed_mps": {"type": "number", "exclusiveMinimum": 0.0},
        "normal_force_magnitude_n": {"type": "number", "exclusiveMinimum": 0.0},
        "normal_force_command_n": {"type": "number", "exclusiveMaximum": 0.0},
        "manual_reference_frozen": {"type": "boolean"},
        "parameter_bounds_version": {"type": ["string", "null"]}
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_frame",
        "sliding_frame",
        "tcp_frame",
        "sliding_frame_transform"
      ],
      "properties": {
        "base_frame": {"const": "base"},
        "sliding_frame": {"const": "sliding_frame"},
        "tcp_frame": {"const": "tool0_controller"},
        "sliding_frame_transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["translation_xyz_m", "quaternion_xyzw"],
          "properties": {
            "translation_xyz_m": {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "items": false
            },
            "quaternion_xyzw": {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "items": false
            }
          }
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bag_path",
        "storage_id",
        "topics",
        "event_topic",
        "tare_service",
        "raw_data_immutable"
      ],
      "properties": {
        "bag_path": {"type": ["string", "null"]},
        "storage_id": {"const": "mcap"},
        "topics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["internal_wrench", "ati_passive_wrench", "tcp_pose", "tf", "tf_static", "joint_states"],
          "properties": {
            "internal_wrench": {"const": "/force_torque_sensor_broadcaster/wrench"},
            "ati_passive_wrench": {"const": "/ati/wrench_passive"},
            "tcp_pose": {"const": "/tcp_pose_broadcaster/pose"},
            "tf": {"const": "/tf"},
            "tf_static": {"const": "/tf_static"},
            "joint_states": {"const": "/joint_states"}
          }
        },
        "event_topic": {"const": "/phase_b_spi_collection/events"},
        "tare_service": {"const": "/io_and_status_controller/zero_ftsensor"},
        "raw_data_immutable": {"type": "boolean"},
        "bag_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ros_distro", "hairpin_skills_commit", "collection_config_path", "collection_config_sha256"],
      "properties": {
        "ros_distro": {"const": "jazzy"},
        "hairpin_skills_commit": {"type": ["string", "null"]},
        "hairpin_skills_dirty": {"type": "boolean"},
        "collection_config_path": {"type": "string"},
        "collection_config_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "collection_script_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "doe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "randomization_seed", "planned_split", "planned_order_index"],
      "properties": {
        "batch_id": {"type": "string"},
        "randomization_seed": {"type": ["integer", "null"]},
        "planned_split": {"enum": ["development", "test", "validation"]},
        "planned_order_index": {"type": "integer", "minimum": 1}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_file", "reference_frozen_before_detector_tuning"],
      "properties": {
        "reference_file": {"type": ["string", "null"]},
        "reference_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reference_frozen_before_detector_tuning": {"type": "boolean"},
        "absolute_edge_x_R_m": {"type": ["number", "null"]},
        "run_slide_start_absolute_x_R_m": {"type": ["number", "null"]},
        "run_relative_r_gt_m": {"type": ["number", "null"]}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "anomaly_flags"],
      "properties": {
        "status": {"enum": ["PLANNED", "COMPLETED", "ABORTED", "INVALID"]},
        "stop_reason": {"type": ["string", "null"]},
        "anomaly_flags": {"type": "array", "items": {"type": "string"}},
        "usable_for_conversion": {"type": ["boolean", "null"]}
      }
    }
  }
}
