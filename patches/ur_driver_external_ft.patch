diff --git a/ur_robot_driver/src/hardware_interface.cpp b/ur_robot_driver/src/hardware_interface.cpp
index ee9be56..607dd6f 100644
--- a/ur_robot_driver/src/hardware_interface.cpp
+++ b/ur_robot_driver/src/hardware_interface.cpp
@@ -154,0 +155,2 @@ URPositionHardwareInterface::on_init(const hardware_interface::HardwareComponent
+  external_ft_rtde_activation_pending_ = false;
+  external_ft_rtde_active_ = false;
@@ -543,0 +546,28 @@ URPositionHardwareInterface::on_configure(const rclcpp_lifecycle::State& previou
+  // The external F/T input has to be enabled after the robot-side External
+  // Control script has connected to the ScriptCommandInterface. Store the
+  // configuration here; asyncThread() performs the actual call on every new
+  // program connection.
+  const auto external_ft_enabled_it = info_.hardware_parameters.find("external_ft_rtde_input_enabled");
+  external_ft_rtde_input_enabled_ =
+      external_ft_enabled_it != info_.hardware_parameters.end() &&
+      (external_ft_enabled_it->second == "true" || external_ft_enabled_it->second == "True");
+  if (external_ft_rtde_input_enabled_) {
+    external_ft_sensor_mass_ = stod(info_.hardware_parameters.at("external_ft_sensor_mass"));
+    external_ft_sensor_measuring_offset_ = {
+      stod(info_.hardware_parameters.at("external_ft_sensor_offset_x")),
+      stod(info_.hardware_parameters.at("external_ft_sensor_offset_y")),
+      stod(info_.hardware_parameters.at("external_ft_sensor_offset_z"))
+    };
+    external_ft_sensor_cog_ = {
+      stod(info_.hardware_parameters.at("external_ft_sensor_cog_x")),
+      stod(info_.hardware_parameters.at("external_ft_sensor_cog_y")),
+      stod(info_.hardware_parameters.at("external_ft_sensor_cog_z"))
+    };
+    RCLCPP_INFO(rclcpp::get_logger("URPositionHardwareInterface"),
+                "External F/T RTDE input will be enabled after External Control connects "
+                "(mass=%.6f kg, offset=[%.6f, %.6f, %.6f] m, cog=[%.6f, %.6f, %.6f] m).",
+                external_ft_sensor_mass_, external_ft_sensor_measuring_offset_[0],
+                external_ft_sensor_measuring_offset_[1], external_ft_sensor_measuring_offset_[2],
+                external_ft_sensor_cog_[0], external_ft_sensor_cog_[1], external_ft_sensor_cog_[2]);
+  }
+
@@ -770,0 +801,10 @@ void URPositionHardwareInterface::asyncThread()
+    if (external_ft_rtde_input_enabled_ && external_ft_rtde_activation_pending_ && robot_program_running_ &&
+        ur_driver_ != nullptr) {
+      if (ur_driver_->ftRtdeInputEnable(true, external_ft_sensor_mass_, external_ft_sensor_measuring_offset_,
+                                        external_ft_sensor_cog_)) {
+        external_ft_rtde_activation_pending_ = false;
+        external_ft_rtde_active_ = true;
+        RCLCPP_INFO(rclcpp::get_logger("URPositionHardwareInterface"),
+                    "External F/T RTDE input activated through the connected External Control script.");
+      }
+    }
@@ -926,0 +967,4 @@ void URPositionHardwareInterface::handleRobotProgramState(bool program_running)
+  if (external_ft_rtde_input_enabled_) {
+    external_ft_rtde_active_ = false;
+    external_ft_rtde_activation_pending_ = program_running;
+  }
